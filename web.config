<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <webSocket enabled="false" />
    <handlers>
      <add name="iisnode" path="src/server.pg.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="NodeApp">
          <match url="/*" />
          <action type="Rewrite" url="src/server.pg.js" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="prisma" />
          <add segment="scripts" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <iisnode nodeProcessCommandLine="node" loggingEnabled="true" logDirectory="iisnode" watchedFiles="web.config;src\*.js" />
  </system.webServer>
</configuration>
