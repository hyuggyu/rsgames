{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm install && npm --prefix frontend install",
  "crons": [
    { "path": "/api/cron/fulfillments", "schedule": "0 3 * * *" }
  ],
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
