NODE_ENV=production
PORT=4000

# Supabase PostgreSQL
DATABASE_URL=postgresql://postgres.PROJECT_REF:DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
DIRECT_URL=postgresql://postgres.PROJECT_REF:DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase API
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-secret-key
SUPABASE_PRIVATE_BUCKET=private-uploads
SUPABASE_PUBLIC_BUCKET=public-assets

# Security
JWT_SECRET=replace-with-at-least-64-random-characters
CODE_ENCRYPTION_KEY=replace-with-a-different-random-value
CRON_SECRET=replace-with-another-random-secret

# Application
CLIENT_ORIGIN=https://your-project.vercel.app
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password
WEB_ROOT=public

# Email — optional
RESEND_API_KEY=
EMAIL_FROM=RS Store <noreply@example.com>

# SMS — optional
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=RS Store